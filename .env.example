# Copy to .env and adjust for local overrides. docker-compose.yml already has
# working defaults for local development; these only need to change for
# non-default setups (e.g. a different JWT secret for sharing a demo).

DB_MIGRATOR_USER=app_migrator
DB_MIGRATOR_PASSWORD=app_migrator
DB_RUNTIME_USER=app_runtime
DB_RUNTIME_PASSWORD=app_runtime

JWT_SECRET=change-me-dev-only-change-me-dev-only
